new file mode 100644
index 00000000..e01b0369
--- /dev/null
+++ b/dm/host/keymap.h
@@ -0,0 +1,235 @@
+// The Mac front end's keyboard and mouse bindings (front_mac.m): a text file the player edits, keymap.txt in the game's folder (DM_ROOT, the app's
+// ~/Library/Application Support/nxnative/<title ID>/; DM_KEYMAP=<path> names another). Each line binds a Switch input (button, stick direction) or a host
+// action to keys and mouse buttons: "A = E, Return". A line replaces that action's defaults; "none" unbinds it. The defaults are KM_DEFAULT_FILE itself,
+// parsed: the file written for the player and the bindings without a file are the same by construction (tests/t_keymap.c).
+// Keys are macOS virtual key codes, so a name is a position on a US layout keyboard whatever the layout in use. The Command keys stay with macOS.
+// Header-only, as home_quit.h and ctrl_prompt.h: pure C, so the parser is tested without AppKit
+#pragma once
+#include <ctype.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// Actions. 0..15 are the controller buttons in dm_input.h's bit order (DM_BTN_A = 1 << 0 … DM_BTN_DOWN = 1 << 15)
+enum {
+    KM_A, KM_B, KM_X, KM_Y, KM_LS, KM_RS, KM_L, KM_R, KM_ZL, KM_ZR, KM_PLUS, KM_MINUS, KM_DLEFT, KM_DUP, KM_DRIGHT, KM_DDOWN,
+    KM_SHAKE,                                    // the controller shaken while held (DM_BTN_SHAKE)
+    KM_LUP, KM_LDOWN, KM_LLEFT, KM_LRIGHT,       // left stick
+    KM_RUP, KM_RDOWN, KM_RLEFT, KM_RRIGHT,       // right stick
+    KM_WALK,                                     // the left stick tilts only walk_speed while held
+    KM_RELEASE_MOUSE, KM_TOGGLE_MOUSE,           // mouse look: let go of the pointer / take it or let it go
+    KM_ACTIONS
+};
+#define KM_BIT(a) (1ull << (a))
+#define KM_BUTTON_MASK 0xffffull                 // the actions that are controller buttons
+
+// Inputs: 0..127 macOS virtual key codes, then the mouse
+enum { KM_MOUSE_LEFT = 128, KM_MOUSE_RIGHT, KM_MOUSE_MIDDLE, KM_MOUSE_4, KM_MOUSE_5, KM_WHEEL_UP, KM_WHEEL_DOWN, KM_INPUTS };
+
+typedef struct {
+    uint64_t in[KM_INPUTS];   // the actions each input does
+    int mouse_look;           // a click in the game window captures the pointer: its motion is the right stick, its buttons as bound
+    int mouse_invert_y;
+    float mouse_sensitivity;  // 0.1 .. 10
+    float walk_speed;         // 0.1 .. 1
+} keymap;
+
+static const struct { const char *name; int action; } KM_ACTION_NAMES[] = {
+    {"A", KM_A}, {"B", KM_B}, {"X", KM_X}, {"Y", KM_Y}, {"LStickPress", KM_LS}, {"RStickPress", KM_RS}, {"L", KM_L}, {"R", KM_R},
+    {"ZL", KM_ZL}, {"ZR", KM_ZR}, {"Plus", KM_PLUS}, {"Minus", KM_MINUS}, {"DLeft", KM_DLEFT}, {"DUp", KM_DUP}, {"DRight", KM_DRIGHT}, {"DDown", KM_DDOWN},
+    {"Shake", KM_SHAKE}, {"LUp", KM_LUP}, {"LDown", KM_LDOWN}, {"LLeft", KM_LLEFT}, {"LRight", KM_LRIGHT},
+    {"RUp", KM_RUP}, {"RDown", KM_RDOWN}, {"RLeft", KM_RLEFT}, {"RRight", KM_RRIGHT}, {"Walk", KM_WALK},
+    {"ReleaseMouse", KM_RELEASE_MOUSE}, {"ToggleMouse", KM_TOGGLE_MOUSE},
+};
+
+// Key names (kVK_* of Carbon's Events.h). Command (54, 55), Function (63) and Caps Lock (57) are not bindable: macOS keeps them
+static const struct { const char *name; int code; } KM_KEY_NAMES[] = {
+    {"A", 0}, {"S", 1}, {"D", 2}, {"F", 3}, {"H", 4}, {"G", 5}, {"Z", 6}, {"X", 7}, {"C", 8}, {"V", 9}, {"B", 11}, {"Q", 12}, {"W", 13}, {"E", 14},
+    {"R", 15}, {"Y", 16}, {"T", 17}, {"1", 18}, {"2", 19}, {"3", 20}, {"4", 21}, {"6", 22}, {"5", 23}, {"Equal", 24}, {"9", 25}, {"7", 26},
+    {"Minus", 27}, {"8", 28}, {"0", 29}, {"RightBracket", 30}, {"O", 31}, {"U", 32}, {"LeftBracket", 33}, {"I", 34}, {"P", 35}, {"Return", 36},
+    {"L", 37}, {"J", 38}, {"Quote", 39}, {"K", 40}, {"Semicolon", 41}, {"Backslash", 42}, {"Comma", 43}, {"Slash", 44}, {"N", 45}, {"M", 46},
+    {"Period", 47}, {"Tab", 48}, {"Space", 49}, {"Grave", 50}, {"Backspace", 51}, {"Escape", 53},
+    {"LShift", 56}, {"LOption", 58}, {"LControl", 59}, {"RShift", 60}, {"ROption", 61}, {"RControl", 62},
+    {"KeypadDecimal", 65}, {"KeypadMultiply", 67}, {"KeypadPlus", 69}, {"KeypadDivide", 75}, {"KeypadEnter", 76}, {"KeypadMinus", 78},
+    {"KeypadEquals", 81}, {"Keypad0", 82}, {"Keypad1", 83}, {"Keypad2", 84}, {"Keypad3", 85}, {"Keypad4", 86}, {"Keypad5", 87}, {"Keypad6", 88},
+    {"Keypad7", 89}, {"Keypad8", 91}, {"Keypad9", 92},
+    {"F1", 122}, {"F2", 120}, {"F3", 99}, {"F4", 118}, {"F5", 96}, {"F6", 97}, {"F7", 98}, {"F8", 100}, {"F9", 101}, {"F10", 109}, {"F11", 103},
+    {"F12", 111}, {"F13", 105}, {"F14", 107}, {"F15", 113},
+    {"Home", 115}, {"PageUp", 116}, {"Delete", 117}, {"End", 119}, {"PageDown", 121}, {"Left", 123}, {"Right", 124}, {"Down", 125}, {"Up", 126},
+    {"MouseLeft", KM_MOUSE_LEFT}, {"MouseRight", KM_MOUSE_RIGHT}, {"MouseMiddle", KM_MOUSE_MIDDLE}, {"Mouse4", KM_MOUSE_4}, {"Mouse5", KM_MOUSE_5},
+    {"WheelUp", KM_WHEEL_UP}, {"WheelDown", KM_WHEEL_DOWN},
+    // other spellings
+    {"Enter", 36}, {"Esc", 53}, {"Shift", 56}, {"Control", 59}, {"Ctrl", 59}, {"LCtrl", 59}, {"RCtrl", 62}, {"Option", 58}, {"Alt", 58}, {"LAlt", 58},
+    {"RAlt", 61}, {"Backtick", 50}, {"Tilde", 50}, {"ArrowUp", 126}, {"ArrowDown", 125}, {"ArrowLeft", 123}, {"ArrowRight", 124},
+};
+
+// The modifier keys arrive as flag changes, not key presses: the device-dependent bit of NSEvent.modifierFlags (IOKit's NX_DEVICE*KEYMASK) that says whether that one is down
+static inline uint64_t km_modifier_flag(int code) {
+    switch (code) {
+        case 56: return 0x02; case 60: return 0x04;      // left / right Shift
+        case 59: return 0x01; case 62: return 0x2000;    // left / right Control
+        case 58: return 0x20; case 61: return 0x40;      // left / right Option
+    }
+    return 0;
+}
+
+static inline int km_streq(const char *a, const char *b) {   // case-insensitive
+    for (; *a && *b; a++, b++) if (tolower((unsigned char)*a) != tolower((unsigned char)*b)) return 0;
+    return !*a && !*b;
+}
+static inline int km_action_id(const char *name) {
+    for (size_t i = 0; i < sizeof KM_ACTION_NAMES / sizeof *KM_ACTION_NAMES; i++) if (km_streq(name, KM_ACTION_NAMES[i].name)) return KM_ACTION_NAMES[i].action;
+    return -1;
+}
+static inline const char *km_action_name(int a) {
+    for (size_t i = 0; i < sizeof KM_ACTION_NAMES / sizeof *KM_ACTION_NAMES; i++) if (KM_ACTION_NAMES[i].action == a) return KM_ACTION_NAMES[i].name;
+    return "?";
+}
+static inline int km_input_code(const char *name) {
+    for (size_t i = 0; i < sizeof KM_KEY_NAMES / sizeof *KM_KEY_NAMES; i++) if (km_streq(name, KM_KEY_NAMES[i].name)) return KM_KEY_NAMES[i].code;
+    return -1;
+}
+static inline const char *km_input_name(int code) {   // the first (canonical) name
+    for (size_t i = 0; i < sizeof KM_KEY_NAMES / sizeof *KM_KEY_NAMES; i++) if (KM_KEY_NAMES[i].code == code) return KM_KEY_NAMES[i].name;
+    return "?";
+}
+
+// The file written for the player when there is none: its bindings are the defaults (km_defaults parses it)
+static const char KM_DEFAULT_FILE[] =
+"# Keyboard and mouse controls (nxnative). Edit and save this file with any text editor: the game reads it\n"
+"# again when its window becomes active (or Controls > Reload Keymap). Delete it to get these defaults back.\n"
+"#\n"
+"# The layout is MacNativeGames' Breath of the Wild / Tears of the Kingdom one (left hand on W A S D, right\n"
+"# hand on the mouse), moved where Ocarina of Time's buttons differ: this game sprints on a held A, not B,\n"
+"# so Shift presses A here (in a menu Shift confirms, like E).\n"
+"#\n"
+"# Each line:  Action = Key   or   Action = Key1, Key2   or   Action = none\n"
+"# A line replaces that action's defaults; a key may do several actions. Text after # is a note.\n"
+"# The left side is a Switch button: the game's on-screen prompts name them (A, B, X, Y, ZL ...).\n"
+"\n"
+"# ---- Mouse ----\n"
+"# mouse_look = on: click in the game window to capture the mouse; moving it turns the camera and its\n"
+"#   buttons do what they are bound to below. The ` key (or switching apps) lets it go.\n"
+"# mouse_look = off: the mouse is the Switch's touchscreen (click = touch).\n"
+"mouse_look = on\n"
+"mouse_sensitivity = 1.0      # 0.1 (slow) to 10 (fast)\n"
+"mouse_invert_y = off\n"
+"walk_speed = 0.5             # how far the left stick tilts while Walk is held, 0.1 to 1\n"
+"\n"
+"# ---- Moving and camera ----\n"
+"LUp = W\n"
+"LDown = S\n"
+"LLeft = A\n"
+"LRight = D\n"
+"RUp = Up                     # the arrow keys turn the camera too (the captured mouse does)\n"
+"RDown = Down\n"
+"RLeft = Left\n"
+"RRight = Right\n"
+"Walk = LControl              # hold to walk slowly (narrow ledges)\n"
+"\n"
+"# ---- Field ----\n"
+"A = E, Return, LShift        # talk, open, pick up, climb; hold Shift (or E) while moving to sprint\n"
+"B = Backspace, X             # put away; back out of a menu\n"
+"X = Space                    # jump\n"
+"Y = MouseLeft, G             # sword\n"
+"ZL = Q, MouseMiddle          # target (lock on), shield\n"
+"ZR = MouseRight, LOption     # use the equipped item (slingshot, bow, hookshot ...)\n"
+"L = F                        # item quick select\n"
+"R = R                        # item quick select\n"
+"DLeft = 2, O                 # ocarina\n"
+"DUp = 3\n"
+"DRight = 4, N                # talk to Navi\n"
+"DDown = 5\n"
+"LStickPress = C\n"
+"RStickPress = V              # camera reset\n"
+"Plus = Escape, I             # the game's menu (items, equipment, quest)\n"
+"Minus = Tab, M               # map\n"
+"Shake = H                    # shakes the controller while held (motion controls)\n"
+"\n"
+"# ---- Mouse capture ----\n"
+"ToggleMouse = Grave          # the ` key: let the mouse go, or take it back without clicking\n"
+"ReleaseMouse = none          # a key that only lets it go\n"
+"\n"
+"# ---- Names you can use ----\n"
+"# Letters A-Z, digits 0-9, F1-F15, Space, Return, Tab, Escape, Backspace, Delete, Up, Down, Left, Right,\n"
+"# Home, End, PageUp, PageDown, LShift, RShift, LControl, RControl, LOption, ROption,\n"
+"# Minus, Equal, LeftBracket, RightBracket, Semicolon, Quote, Comma, Period, Slash, Backslash, Grave,\n"
+"# Keypad0-Keypad9, KeypadPlus, KeypadMinus, KeypadMultiply, KeypadDivide, KeypadDecimal, KeypadEnter, KeypadEquals,\n"
+"# and while the mouse is captured: MouseLeft, MouseRight, MouseMiddle, Mouse4, Mouse5, WheelUp, WheelDown.\n"
+"# Keys are by position on a US keyboard. The Command keys stay with macOS (Command-Q quits).\n"
+"# Actions: A B X Y L R ZL ZR Plus Minus DUp DDown DLeft DRight LStickPress RStickPress Shake\n"
+"#          LUp LDown LLeft LRight RUp RDown RLeft RRight Walk ReleaseMouse ToggleMouse\n";
+
+static inline void km_clear(keymap *k) { memset(k, 0, sizeof *k); k->mouse_sensitivity = 1.f; k->walk_speed = .5f; }
+
+static inline char *km_trim(char *s) {
+    while (isspace((unsigned char)*s)) s++;
+    char *e = s + strlen(s); while (e > s && isspace((unsigned char)e[-1])) *--e = 0;
+    return s;
+}
+static inline int km_onoff(const char *v) {   // 1, 0, or -1 when neither
+    if (km_streq(v, "on") || km_streq(v, "true") || km_streq(v, "yes") || km_streq(v, "1")) return 1;
+    if (km_streq(v, "off") || km_streq(v, "false") || km_streq(v, "no") || km_streq(v, "0")) return 0;
+    return -1;
+}
+
+// Parses text over k (whatever k holds already stays unless a line changes it). Returns the number of lines it could not take, each described in err
+// ("line N: …", one per line, as many as fit); those lines change nothing
+static inline int km_parse(keymap *k, const char *text, char *err, size_t errlen) {
+    int bad = 0, ln = 0; size_t used = 0; if (err && errlen) *err = 0;
+    #define KM_BAD(...) do { bad++; if (err && used < errlen) { int w = snprintf(err + used, errlen - used, "line %d: ", ln); if (w > 0) used += (size_t)w; \
+        if (used < errlen) { w = snprintf(err + used, errlen - used, __VA_ARGS__); if (w > 0) used += (size_t)w; } if (used < errlen) { err[used++] = '\n'; err[used < errlen ? used : errlen - 1] = 0; } } } while (0)
+    const char *p = text;
+    while (p && *p) {
+        const char *nl = strchr(p, '\n'); size_t n = nl ? (size_t)(nl - p) : strlen(p);
+        char line[512]; ln++;
+        if (n >= sizeof line) { KM_BAD("too long"); p = nl ? nl + 1 : NULL; continue; }
+        memcpy(line, p, n); line[n] = 0; p = nl ? nl + 1 : NULL;
+        char *h = strchr(line, '#'); if (h) *h = 0;
+        char *s = km_trim(line); if (!*s) continue;
+        char *eq = strchr(s, '='); if (!eq) { KM_BAD("no '=' in \"%s\"", s); continue; }
+        *eq = 0; char *name = km_trim(s), *val = km_trim(eq + 1);
+        if (km_streq(name, "mouse_look") || km_streq(name, "mouse_invert_y")) {
+            int v = km_onoff(val); if (v < 0) { KM_BAD("%s takes on or off, not \"%s\"", name, val); continue; }
+            if (km_streq(name, "mouse_look")) k->mouse_look = v; else k->mouse_invert_y = v;
+            continue;
+        }
+        if (km_streq(name, "mouse_sensitivity") || km_streq(name, "walk_speed")) {
+            char *end; float v = strtof(val, &end); int sens = km_streq(name, "mouse_sensitivity");
+            if (end == val || *km_trim(end) || v < (sens ? .1f : .1f) || v > (sens ? 10.f : 1.f)) { KM_BAD("%s takes a number from %s, not \"%s\"", name, sens ? "0.1 to 10" : "0.1 to 1", val); continue; }
+            if (sens) k->mouse_sensitivity = v; else k->walk_speed = v;
+            continue;
+        }
+        int a = km_action_id(name);
+        if (a < 0) { KM_BAD("unknown action \"%s\"", name); continue; }
+        int codes[16], nc = 0, ok = 1;
+        if (!km_streq(val, "none") && *val) {
+            char *q = val;
+            while (q && ok) {
+                char *c = strchr(q, ','); if (c) *c = 0;
+                char *kn = km_trim(q); q = c ? c + 1 : NULL;
+                if (!*kn) continue;
+                int code = km_input_code(kn);
+                if (code < 0) { KM_BAD("unknown key \"%s\" for %s", kn, km_action_name(a)); ok = 0; break; }
+                if (nc < (int)(sizeof codes / sizeof *codes)) codes[nc++] = code;
+            }
+        }
+        if (!ok) continue;
+        for (int i = 0; i < KM_INPUTS; i++) k->in[i] &= ~KM_BIT(a);   // the line replaces the action's keys
+        for (int i = 0; i < nc; i++) k->in[codes[i]] |= KM_BIT(a);
+    }
+    #undef KM_BAD
+    return bad;
+}
+
+static inline void km_defaults(keymap *k) { km_clear(k); km_parse(k, KM_DEFAULT_FILE, NULL, 0); }
+
+// The keys of one action, comma-separated ("E, Return"), or "none"
+static inline void km_keys_of(const keymap *k, int a, char *out, size_t n) {
+    size_t u = 0; if (n) *out = 0;
+    for (int i = 0; i < KM_INPUTS; i++) if (k->in[i] & KM_BIT(a)) {
+        int w = snprintf(out + u, u < n ? n - u : 0, "%s%s", u ? ", " : "", km_input_name(i)); if (w > 0) u += (size_t)w;
+    }
+    if (!u && n) snprintf(out, n, "none");
+}
