diff --git a/dm/host/tests/t_keymap.c b/dm/host/tests/t_keymap.c
new file mode 100644
index 00000000..10bebcf1
--- /dev/null
+++ b/dm/host/tests/t_keymap.c
@@ -0,0 +1,56 @@
+// The keyboard and mouse bindings (keymap.h): the default file parses whole and binds every action, no default key does two things, a line replaces
+// its action's keys, "none" unbinds, unknown names and out-of-range values are reported and change nothing, names are case-insensitive with their
+// other spellings, and the key table names only bindable codes
+#include "../keymap.h"
+#include <stdio.h>
+
+static int checks, fails;
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s (line %d)\n", msg, __LINE__); } } while (0)
+
+static int bound(const keymap *k, int code, int a) { return (k->in[code] & KM_BIT(a)) != 0; }
+
+int main(void) {
+    keymap k; char err[1024];
+    km_clear(&k);
+    CHECK(km_parse(&k, KM_DEFAULT_FILE, err, sizeof err) == 0, "the default file parses with no problem");
+    keymap d; km_defaults(&d);
+    CHECK(!memcmp(&k, &d, sizeof k), "km_defaults is the default file parsed");
+    CHECK(d.mouse_look == 1 && d.mouse_invert_y == 0 && d.mouse_sensitivity == 1.f && d.walk_speed == .5f, "default mouse and walk settings");
+    for (int a = 0; a < KM_ACTIONS; a++) { if (a == KM_RELEASE_MOUSE) continue;   // none by default: Escape is the menu, the ` key toggles
+        int any = 0; for (int i = 0; i < KM_INPUTS; i++) any |= bound(&d, i, a); CHECK(any, km_action_name(a)); }
+    for (int i = 0; i < KM_INPUTS; i++) { uint64_t m = d.in[i]; CHECK(!(m & (m - 1)), "no default key does two actions"); }
+    CHECK(bound(&d, km_input_code("E"), KM_A) && bound(&d, km_input_code("Return"), KM_A) && bound(&d, 56, KM_A), "A = E, Return, LShift (sprint)");
+    CHECK(bound(&d, KM_MOUSE_LEFT, KM_Y) && bound(&d, KM_MOUSE_RIGHT, KM_ZR) && bound(&d, KM_MOUSE_MIDDLE, KM_ZL), "mouse buttons: sword, item, target");
+    CHECK(bound(&d, 49, KM_X) && bound(&d, 53, KM_PLUS) && bound(&d, 48, KM_MINUS) && bound(&d, 12, KM_ZL), "Space jumps, Escape menu, Tab map, Q targets");
+    CHECK(bound(&d, 13, KM_LUP) && bound(&d, 0, KM_LLEFT) && bound(&d, 1, KM_LDOWN) && bound(&d, 2, KM_LRIGHT), "WASD by key code");
+    CHECK(bound(&d, 126, KM_RUP) && bound(&d, 59, KM_WALK) && bound(&d, 50, KM_TOGGLE_MOUSE), "arrows, LControl, Grave");
+    { uint64_t r = 0; for (int i = 0; i < KM_INPUTS; i++) r |= d.in[i] & KM_BIT(KM_RELEASE_MOUSE); CHECK(!r, "ReleaseMouse is none by default"); }
+    char keys[128]; km_keys_of(&d, KM_A, keys, sizeof keys);
+    CHECK(!strcmp(keys, "E, Return, LShift"), "keys of an action, in code order");
+
+    keymap o = d;
+    CHECK(km_parse(&o, "a = j   # a note\n\n  # only a note\nB = none\nwalk = Ctrl\nmouse_look = off\nmouse_sensitivity = 2.5\n", err, sizeof err) == 0, "an override file");
+    CHECK(bound(&o, km_input_code("J"), KM_A) && !bound(&o, km_input_code("E"), KM_A) && !bound(&o, 36, KM_A), "a line replaces the action's keys");
+    km_keys_of(&o, KM_B, keys, sizeof keys);
+    CHECK(!strcmp(keys, "none") && !bound(&o, KM_MOUSE_LEFT, KM_B), "none unbinds");
+    CHECK(bound(&o, 59, KM_WALK), "Ctrl is LControl");
+    CHECK(o.mouse_look == 0 && o.mouse_sensitivity == 2.5f, "settings");
+    CHECK(bound(&o, 13, KM_LUP), "actions the file does not name keep theirs");
+
+    keymap e = d;
+    CHECK(km_parse(&e, "A = Banana\nJump = Space\nmouse_sensitivity = 50\nwalk_speed = x\nmouse_look = maybe\nno equals here\n", err, sizeof err) == 6, "six bad lines");
+    CHECK(!memcmp(&e, &d, sizeof e), "bad lines change nothing");
+    CHECK(strstr(err, "line 1: unknown key \"Banana\"") && strstr(err, "line 2: unknown action \"Jump\"") && strstr(err, "line 6: no '='"), "the problems are named by line");
+    keymap two = d;
+    CHECK(km_parse(&two, "X = E\n", NULL, 0) == 0 && bound(&two, km_input_code("E"), KM_A) && bound(&two, km_input_code("E"), KM_X), "a key may do two actions");
+
+    for (size_t i = 0; i < sizeof KM_KEY_NAMES / sizeof *KM_KEY_NAMES; i++) {
+        int c = KM_KEY_NAMES[i].code;
+        CHECK(c >= 0 && c < KM_INPUTS && c != 54 && c != 55 && c != 57 && c != 63, KM_KEY_NAMES[i].name);
+    }
+    CHECK(km_input_code("Command") < 0 && km_input_code("CapsLock") < 0, "Command and Caps Lock are not bindable");
+    CHECK(km_modifier_flag(56) && km_modifier_flag(60) && km_modifier_flag(59) && km_modifier_flag(62) && km_modifier_flag(58) && km_modifier_flag(61)
+          && !km_modifier_flag(57) && !km_modifier_flag(0), "the modifier keys and their flags");
+    printf("t_keymap: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
