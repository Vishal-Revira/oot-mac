+// Mouse look: the pointer captured (hidden and held in place, CGAssociateMouseAndMouseCursorPosition) turns the right stick. A stick is a rate, so the motion of each
+// 1/120 s is a deflection: 6 points a tick (720 points a second) is the whole stick at sensitivity 1, eased over about two ticks so the camera does not step at the tick rate
+static NSTimer *g_mtimer;
+static void mouse_tick(void) {
+    float k = g_km.mouse_sensitivity / 6.f;
+    float tx = fmaxf(-1.f, fminf(1.f, (float)g_mdx * k)), ty = fmaxf(-1.f, fminf(1.f, (float)-g_mdy * k * (g_km.mouse_invert_y ? -1.f : 1.f)));   // AppKit's deltaY grows downward
+    g_mdx = g_mdy = 0;
+    float nx = .5f * g_mrx + .5f * tx, ny = .5f * g_mry + .5f * ty;
+    if (fabsf(nx) < .01f) nx = 0;
+    if (fabsf(ny) < .01f) ny = 0;
+    if (nx != g_mrx || ny != g_mry) { g_mrx = nx; g_mry = ny; push(); }
+}
